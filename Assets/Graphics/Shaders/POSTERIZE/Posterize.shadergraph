{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2d7fcf4a386c4fe39af428e6175f6db1",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Dither (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1743.2000732421875,
            "y": 509.6000061035156,
            "width": 190.4000244140625,
            "height": 76.80001831054688
        }
    },
    "m_Slots": [
        {
            "m_Id": "98ee0b115dfe42d7bc4313fd413ee6da"
        },
        {
            "m_Id": "e4e16907a238438ebf773c0a0afead49"
        },
        {
            "m_Id": "060887b79d5d45d29e6981c5a55ea00a"
        },
        {
            "m_Id": "41593ef05d654f19ab1a5db3b8597998"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Dither",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float referenceHeight = 1080.0;\nfloat resolutionScale = (_ScreenParams.y / referenceHeight) / DisplayUpscale;\nfloat2 screenPixel = floor(UV * _ScreenParams.xy / (DitherScale * resolutionScale));\nfloat2 pixel = fmod(screenPixel, 8.0);\nint x = (int)pixel.x;\nint y = (int)pixel.y;\nfloat bayer8x8[64] = {\n    0, 48, 12, 60, 3, 51, 15, 63,\n    32, 16, 44, 28, 35, 19, 47, 31,\n    8, 56, 4, 52, 11, 59, 7, 55,\n    40, 24, 36, 20, 43, 27, 39, 23,\n    2, 50, 14, 62, 1, 49, 13, 61,\n    34, 18, 46, 30, 33, 17, 45, 29,\n    10, 58, 6, 54, 9, 57, 5, 53,\n    42, 26, 38, 22, 41, 25, 37, 21\n};\nOut = bayer8x8[y * 8 + x] / 64.0;"
}

