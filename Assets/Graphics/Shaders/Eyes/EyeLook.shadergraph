{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "22ad6564d61f4b1ca7bb443629e430c7",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SphereEyeUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -667.199951171875,
            "y": 1377.599853515625,
            "width": 233.5999755859375,
            "height": 189.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "e5ec0cc5db794b9fb0bef81c2bdfeb06"
        },
        {
            "m_Id": "c68698a33ba8458caac5ef633991bb47"
        },
        {
            "m_Id": "6cff2220ac53474cab85da2e759346f4"
        },
        {
            "m_Id": "446e1aa9d7084283bd24fa7baf95bdef"
        },
        {
            "m_Id": "fdc3d75b3bb34f1b93301f03dedc2aac"
        },
        {
            "m_Id": "0ef3259fc61d41a8bc8ad7eed0c170c4"
        },
        {
            "m_Id": "84cabd4d07244df28ef35476e8a30d3d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SphereEyeUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(normalOS);\nfloat3 F = normalize(forwardOS);\nfloat3 L = normalize(lookDirOS);\n\nfloat cosMax = cos(radians(maxAngle));\nfloat d = dot(L, F);\n\nif (d < cosMax)\n{\n    float3 tangential = L - F * d;\n    float len = length(tangential);\n    tangential = len > 0.0001 ? tangential / len : float3(1, 0, 0);\n    L = normalize(F * cosMax + tangential * sin(radians(maxAngle)));\n}\n\nfloat3 up = abs(L.y) > 0.99 ? float3(0, 0, 1) : float3(0, 1, 0);\nfloat3 T = normalize(cross(up, L));\nfloat3 B = cross(L, T);\n\nfloat sinIris = max(sin(radians(irisAngle)), 0.0001);\nfloat2 proj = float2(dot(N, T), dot(N, B)) / sinIris;\n\nuv = proj * 0.5 + 0.5;\nirisMask = (1.0 - smoothstep(0.92, 1.0, length(proj))) * step(0.0, dot(N, L));"
}

