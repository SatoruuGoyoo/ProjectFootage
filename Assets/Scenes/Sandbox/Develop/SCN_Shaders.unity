  promptIcon: {fileID: 0}
  activeIcon: {fileID: 0}
  subtitles: {fileID: 1731808154}
  subtitleEntries:
  - text: The neighbors of [BEEP] are shaken by the brutal murder of [BEEP], the
      beloved daughter of the [BEEP] family.
    duration: 10
    position: 7
  - text: 'The incident, though details remain uncharted, recounts: <color=red>first</color>
      the killer''s approach <color=red>and then</color> his subsequent escape'
    duration: 8
    position: 7
  - text: The stabbing was <color=red>repeated</color>
    duration: 3
    position: 7
  - text: "A true tragedy\u2026"
    duration: 3
    position: 7
  oneTimeOnly: 0
